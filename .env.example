# Copy to the club-3090 checkout as .env when booting vLLM profiles.
# MODEL_DIR is also read by the compose files in this repo.

MODEL_DIR=/path/to/weights
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# long-text measured at 105000. tools-text OOMs if this is set above 75000.
# Leave the line commented unless the running profile is vllm/long-text.
# MAX_MODEL_LEN=105000
